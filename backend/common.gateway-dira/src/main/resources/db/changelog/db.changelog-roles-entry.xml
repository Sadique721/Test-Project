    <changeSet  id="KSRE00000001" author="Kalp Shah">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM tblmroles WHERE rolename='Iwf_Admin';
            </sqlCheck>
        </preConditions>
        <insert tableName="tblmroles">
            <column name="MVNOID" value="1"/>
            <column name="roleid" valueNumeric="(select COALESCE(roleid + 1)  from tblmroles t order by roleid desc limit 1)"></column>
            <column name="rolename" value="Iwf_Admin"></column>
            <column name="rstatus" value="Active"></column>
            <column name="is_delete" value="0"></column>
            <column name="sysrole" value="1"></column>
            <column name="createbyname" value="admin admin"></column>
            <column name="updatebyname" value="admin admin"></column>
            <column name="createdbystaffid" value="1"></column>
            <column name="lastmodifiedbystaffid" value="1"></column>
            <column name="createdate" value="2024-01-25 18:53:48"></column>
            <column name="lastmodifieddate" value="2021-01-25 18:53:48"></column>
            <column name="product" value="iwf"></column>
        </insert>
    </changeSet>
    <!--    Update Default Data in Staff Role Rel Table for iwf-->
    <changeSet id="KSRE00000002" author="Kalp Shah" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM tbltstaffrolerel WHERE staffid=(select staffid from tblmstaffuser  where username='adminiwf') and roleid=(select roleid from tblmroles  where rolename='Iwf_Admin');
            </sqlCheck>
        </preConditions>
        <update tableName="tbltstaffrolerel">
            <column name="staffid" valueNumeric="(select staffid  from tblmstaffuser  where username='adminiwf')"/>
            <column name="roleid" valueNumeric="(select roleid from tblmroles  where rolename='Iwf_Admin')"></column>
            <where>
                staffid=(select staffid  from tblmstaffuser  where username='adminiwf') and roleid=1
            </where>
        </update>
    </changeSet>
