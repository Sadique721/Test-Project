<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:pro="http://www.liquibase.org/xml/ns/pro"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd
http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-3.8.xsd">

    <changeSet id="YPI000000001" author="Yogesh Patil">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tblmproduct"></tableExists>
            </not>
        </preConditions>
        <createTable tableName="tblmproduct">
            <column name="product_id" type="bigint">
                <constraints primaryKey="true" nullable="false"
                             primaryKeyName="tblmproduct_product_id_pk" unique="true"
                             uniqueConstraintName="tblmproduct_product_id_unq"/>
            </column>
            <column name="name" type="varchar(250)"/>
            <column name="unit" type="varchar(100)"/>
            <column name="description" type="varchar(500)"/>
            <column name="status" type="varchar(100)"/>
            <column name="mvno_id" type="bigint"/>
            <column name="createdate" type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP">
            </column>
            <column name="lastmodifieddate" type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP">
            </column>
            <column name="createbyname" type="varchar(100)"/>
            <column name="updatebyname" type="varchar(100)"/>
            <column name="createdbystaffid" type="bigint"/>
            <column name="lastmodifiedbystaffid" type="bigint"/>
            <column name="is_deleted" type="tinyint(1)" defaultValue="0"/>
            <column name="expiry_time" type="number"></column>
            <column name="expiry_time_unit" type="varchar(10)"></column>
            <column name="pc_id" type="bigint" ></column>
            <column name="total_in_ports" type="bigint" defaultValue="-1"/>
            <column name="available_in_ports" type="bigint" defaultValue="-1"/>
            <column name="total_out_ports" type="bigint" defaultValue="-1"/>
            <column name="available_out_ports" type="bigint" defaultValue="-1"/>
            <column name="rms_product_id" type="varchar(50)"/>
            <column name="nav_ledger_id" type="varchar(50)"/>
            <column name="refurb_prod_charge_id" type="bigint"/>
            <column name="refurb_pra_in_wrty" type="double"/>
            <column name="new_prod_charge_id" type="bigint"></column>
            <column name="refurb_pra_post_wrty" type="double"></column>
            <column name="new_pra_in_wrty" type="double"></column>
            <column name="new_pra_post_wrty" type="double"></column>
            <column name="case_id" type="bigint"/>
            <column name="vendorid" type="bigint"/>
            <column name="actualpricenewproduct" type ="varchar(250)"></column>
            <column name="actualpricerefurbishedproduct" type ="varchar(250)"></column>
        </createTable>
    </changeSet>

    <changeSet id="YPI000000002" author="Yogesh Patil">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tblmproductcategory"></tableExists>
            </not>
        </preConditions>
        <createTable tableName="tblmproductcategory">
            <column name="product_id" type="bigint">
                <constraints primaryKey="true" nullable="false"
                             primaryKeyName="tblmproductcategory_product_id_pk" unique="true"
                             uniqueConstraintName="tblmproductcategory_product_id_unq"/>
            </column>
            <column name="name" type="varchar(250)"/>
            <column name="unit" type="varchar(100)"/>
            <column name="status" type="varchar(100)"/>
            <column name="mvno_id" type="bigint"/>
            <column name="type" type="varchar(100)"/>
            <column name="has_mac" type="tinyint(1)" defaultValue="0"/>
            <column name="has_serial" type="tinyint(1)" defaultValue="0"/>
            <column name="createdate" type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP">
            </column>
            <column name="lastmodifieddate" type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP">
            </column>
            <column name="createbyname" type="varchar(100)"/>
            <column name="updatebyname" type="varchar(100)"/>
            <column name="createdbystaffid" type="bigint"/>
            <column name="lastmodifiedbystaffid" type="bigint"/>
            <column name="is_deleted" type="tinyint(1)" defaultValue="0"/>
            <column name="rms_product_id" type="varchar(100)"/>
            <column name="has_trackable" type="tinyint(1)" defaultValue="0"/>
            <column name="has_port" type="tinyint(1)" defaultValue="0"/>
            <column name="has_cas" type="tinyint(1)" defaultValue="0"/>
            <column name="dtvcategory" type="varchar(200)"></column>
        </createTable>
    </changeSet>

    <changeSet id="YPI000000003" author="Yogesh Patil">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tbltcustomerinventorymapping"></tableExists>
            </not>
        </preConditions>
        <createTable tableName="tbltcustomerinventorymapping">
            <column name="mapping_id" type="bigint">
                <constraints primaryKey="true" nullable="false"
                             primaryKeyName="tbltcustomerinventorymapping_mapping_id_pk" unique="true"
                             uniqueConstraintName="tbltcustomerinventorymapping_mapping_id_unq"/>
            </column>
            <column name="quantity" type="bigint"/>
            <column name="customer_id" type="bigint"/>
            <column name="product_id" type="bigint"/>
            <column name="inward_id" type="bigint"/>
            <column name="external_item_id" type="bigint"/>
            <column name="service_id" type="bigint"/>
            <column name="custpack_id" type="bigint"/>
            <column name="item_id" type="bigint"></column>
            <column name="itemassemblyid" type="bigint"/>
            <column name="connection_no" type="varchar(200)"></column>
            <column name="is_invoice_created" type="tinyint(1)" defaultValue="0" />
            <column name="replacement_reason" type="varchar(200)"></column>
            <column name="plan_id" type="bigint"/>
            <column name="mapping_ref_id" type="bigint"></column>
            <column name="remark" type="varchar(100)"></column>
            <column name="staff_id" type="bigint"/>
            <column name="assigned_date_time" type="TIMESTAMP"/>
            <column name="mvno_id" type="bigint"/>
            <column name="plangroup_id" type="bigint"></column>
            <column name="offer_price" type="double"></column>
            <column name="charge_id" type="bigint"></column>
            <column name="bill_to" type="varchar(25)" defaultValue="CUSTOMER"></column>
            <column name="is_invoice_to_org" type="tinyint(1)" defaultValue="0"></column>
            <column name="new_amount" type="decimal(20,4)"></column>
            <column name="discount" type="double"/>
            <column name="is_required_approval" type="tinyint(1)" defaultValue="0"/>
            <column name="is_free" type="tinyint(1)" defaultValue="0"/>
            <column name="payment_owner_id" type="bigint"></column>
            <column name="ezybill_stock_id" type="varchar(100)"/>
            <column name="billable_cust_id" type="bigint"></column>
            <column name="pairstatus" type="varchar(100)"></column>
            <column name="non_seri_remark" type="varchar(250)"></column>
            <column name="createdate" type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP">
            </column>
            <column name="lastmodifieddate" type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP">
            </column>
            <column name="createbyname" type="varchar(100)"/>
            <column name="updatebyname" type="varchar(100)"/>
            <column name="createdbystaffid" type="bigint"/>
            <column name="lastmodifiedbystaffid" type="bigint"/>
            <column name="is_deleted" type="tinyint(1)" defaultValue="0"/>
            <column name="status" type="varchar(50)"></column>
            <column name="expiry_date_time" type="timestamp"></column>
            <column name="next_approver" type="bigint"/>
            <column name="team_hierarchy_mapping_id" type="bigint"/>
            <column name="previous_approve_id" type="bigint"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
