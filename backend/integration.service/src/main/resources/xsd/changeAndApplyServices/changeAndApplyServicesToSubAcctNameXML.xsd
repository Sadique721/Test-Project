<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://npm.redback.com"
           xmlns="http://npm.redback.com"
           elementFormDefault="qualified">

    <!-- Root element for the SOAP body -->
    <xs:element name="changeAndApplyServicesToSubAcctNameXML">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="String_1" type="xs:string" form="unqualified"/>
                <xs:element name="String_2" type="xs:string" form="unqualified"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Response Element -->
    <xs:element name="getChangeAndApplyServicesToSubAcctNameXMLResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="result" type="xs:anyURI"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
