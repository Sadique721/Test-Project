<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           targetNamespace="http://npm.redback.com"
           xmlns="http://npm.redback.com"
           elementFormDefault="qualified">



    <xs:element name="removeService">
        <xs:complexType>
            <xs:sequence>
                <!-- First String Element -->
                <xs:element name="String_1" form="unqualified" type="xs:string"/>

                <!-- Second String Element -->
                <xs:element name="String_2" form="unqualified" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Response Element -->
    <xs:element name="removeServiceResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="result" type="xs:anyURI"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- MultiRef ResultType -->
    <xs:complexType name="ResultType">
        <xs:sequence>
            <xs:element name="href" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Fault Message for InvalidSubscriberAccountException -->
    <xs:complexType name="InvalidSubscriberAccountException">
        <xs:sequence>
            <xs:element name="message" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>


</xs:schema>
