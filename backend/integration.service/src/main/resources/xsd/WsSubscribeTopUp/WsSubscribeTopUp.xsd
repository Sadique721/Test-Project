<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           targetNamespace="http://subscription.ws.nvsmx.elitecore.com/"
           xmlns="http://subscription.ws.nvsmx.elitecore.com/"
           elementFormDefault="qualified">


    <!-- Request Element -->
    <xs:element name="wsSubscribeTopUp">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" name="subscriberId" type="xs:string" form="unqualified"/>
                <xs:element minOccurs="0" name="updateAction" type="xs:string" form="unqualified"/>
                <xs:element minOccurs="0" name="topUpPackageId" type="xs:string" form="unqualified"/>
                <xs:element minOccurs="0" name="topUpPackageName" type="xs:string" form="unqualified"/>
                <xs:element minOccurs="0" name="subscriptionStatusValue" type="xs:string" form="unqualified"/>
                <xs:element minOccurs="0" name="startTime" type="xs:string" form="unqualified"/>
                <xs:element minOccurs="0" name="endTime" type="xs:string" form="unqualified"/>
                <xs:element minOccurs="0" name="parameter1" type="xs:string" form="unqualified"/>
                <xs:element minOccurs="0" name="parameter2" type="xs:string" form="unqualified"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="wsSubscribeTopUpResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="return">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="responseCode" type="xs:int"/>
                            <xs:element name="responseMessage" type="xs:string"/>
                            <xs:element name="topUpSubscriptions" minOccurs="0">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="endTime" type="xs:long"/>
                                        <xs:element name="startTime" type="xs:long"/>
                                        <xs:element name="subscriberIdentity" type="xs:string"/>
                                        <xs:element name="topUpId" type="xs:long"/>
                                        <xs:element name="topUpName" type="xs:string"/>
                                        <xs:element name="topUpStatus" type="xs:string"/>
                                        <xs:element name="topUpSubscriptionId" type="xs:string"/>
                                        <xs:element name="usageResetTime" type="xs:long"/>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>


</xs:schema>
