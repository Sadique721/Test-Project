<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           targetNamespace="http://npm.redback.com"
           xmlns="http://npm.redback.com"
           elementFormDefault="qualified">



    <!-- Root element for the SOAP body -->
    <xs:element name="addServiceToSubAcctName">
        <xs:complexType>
            <xs:sequence>
                <!-- First String Element -->
                <xs:element name="String_1" form="unqualified">
                    <xs:complexType>
                        <xs:simpleContent>
                            <xs:extension base="xs:string">
                                <!-- Define xsi:type attribute here -->
                                <xs:attribute name="type" type="xs:string" use="required" />
                            </xs:extension>
                        </xs:simpleContent>
                    </xs:complexType>
                </xs:element>

                <!-- Second String Element -->
                <xs:element name="String_2" form="unqualified">
                    <xs:complexType>
                        <xs:simpleContent>
                            <xs:extension base="xs:string">
                                <!-- Define xsi:type as an attribute in the content -->
                                <xs:attribute name="type" type="xs:string" use="required" />
                            </xs:extension>
                        </xs:simpleContent>
                    </xs:complexType>
                </xs:element>

            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Response Element -->
    <xs:element name="addServiceToSubAcctNameResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="result" type="xs:anyURI"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- MultiRef ResultType -->
    <xs:complexType name="ResultType">
        <xs:sequence>
            <xs:element name="href" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Fault Message for InvalidSubscriberAccountException -->
    <xs:complexType name="InvalidSubscriberAccountException">
        <xs:sequence>
            <xs:element name="message" type="xs:string"/>
        </xs:sequence>
    </xs:complexType>


</xs:schema>
