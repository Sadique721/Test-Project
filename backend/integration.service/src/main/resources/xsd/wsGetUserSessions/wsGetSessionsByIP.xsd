<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:api="http://api.act.com/"
           targetNamespace="http://api.act.com/"
           elementFormDefault="qualified">

    <!-- Definition for the wsGetUserSessionRequest -->
    <xs:element name="wsGetUserSession">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="actionItem" type="xs:string" minOccurs="0" form="unqualified"/>
                <xs:element name="requestId" type="xs:string" minOccurs="0" form="unqualified"/>
                <xs:element name="ipAddress" type="xs:string" minOccurs="0" form="unqualified"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Definition for the wsGetUserSessionResponse -->
    <xs:element name="wsGetUserSessionResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="GetUserSession">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="acctSessionId" type="xs:string" minOccurs="0"/>
                            <xs:element name="callingStationId" type="xs:string" minOccurs="0"/>
                            <xs:element name="circuitType" type="xs:string" minOccurs="0"/>
                            <xs:element name="context" type="xs:string" minOccurs="0"/>
                            <xs:element name="delegatedIpv6Prefixes" type="xs:string" minOccurs="0"/>
                            <xs:element name="framedIpv6Prefixes" type="xs:string" minOccurs="0"/>
                            <xs:element name="macAddress" type="xs:string" minOccurs="0"/>
                            <xs:element name="medium" type="xs:string" minOccurs="0"/>
                            <xs:element name="NASPortId" type="xs:string" minOccurs="0"/>
                            <xs:element name="NASPortType" type="xs:string" minOccurs="0"/>
                            <xs:element name="nasId" type="xs:string" minOccurs="0"/>
                            <xs:element name="nasType" type="xs:string" minOccurs="0"/>
                            <xs:element name="requestId" type="xs:string" minOccurs="0"/>
                            <xs:element name="responeCode" type="xs:int" minOccurs="0"/>
                            <xs:element name="responseMessage" type="xs:string" minOccurs="0"/>
                            <xs:element name="sessionId" type="xs:string" minOccurs="0"/>
                            <xs:element name="sessionIp" type="xs:string" minOccurs="0"/>
                            <xs:element name="startTime" type="xs:string" minOccurs="0"/>
                            <xs:element name="subscriberAccount" type="xs:string" minOccurs="0"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
