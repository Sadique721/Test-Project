<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://api.act.com/"
           xmlns:tns="http://api.act.com/">

    <!-- Define the AuthenticateUser type -->
    <xs:complexType name="AuthenticateUser">
        <xs:sequence>
            <xs:element name="requestId" type="xs:string"/>
            <xs:element name="responeCode" type="xs:string"/>
            <xs:element name="responseMessage" type="xs:string"/>
            <xs:element name="result" type="xs:boolean"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Define the response element -->
    <xs:element name="wsAuthenticateUserResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="AuthenticateUser" type="tns:AuthenticateUser"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>