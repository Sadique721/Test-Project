<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:pro="http://www.liquibase.org/xml/ns/pro"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd
http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-3.8.xsd">

    <changeSet id="PR0021082501" author="Prasant Kumar" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="tbltcustomerinventorymapping" columnName="inventory_job_type"/>
            </not>
        </preConditions>
        <addColumn tableName="tbltcustomerinventorymapping">
            <column name="inventory_job_type" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="PR0021082502" author="Prasant Kumar" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="tbltcustomerinventorymapping" columnName="nature"/>
            </not>
        </preConditions>
        <addColumn tableName="tbltcustomerinventorymapping">
            <column name="nature" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="RDS0006122501" author="IG_D003" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="tbltcustomerinventorymapping" columnName="inventory_job_type"/>
            <columnExists tableName="tbltcustomerinventorymapping" columnName="nature"/>
        </preConditions>

        <modifyDataType
                tableName="tbltcustomerinventorymapping"
                columnName="inventory_job_type"
                newDataType="varchar(50)"/>

        <modifyDataType
                tableName="tbltcustomerinventorymapping"
                columnName="nature"
                newDataType="varchar(50)"/>
    </changeSet>


</databaseChangeLog>
