<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:pro="http://www.liquibase.org/xml/ns/pro"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd
http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-3.8.xsd">


    <!-- Remove old entries from the table -->
    <changeSet id="ROLE000001" author="AKSHAY MEWADA">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="tblmrole"/>
        </preConditions>
        <sql>
            DELETE FROM tblmrole;
        </sql>
    </changeSet>

    <!-- Adding default roles -->
    <changeSet id="ROLE000002" author="AKSHAY MEWADA">
        <insert tableName="tblmrole">
            <column name="mvnoid" value="1"/>
            <column name="roleid" valueNumeric="1"></column>
            <column name="name" value="Admin"></column>
        </insert>
    </changeSet>

    <changeSet  id="SC0000000003" author="Shubham Chechani">
        <preConditions onFail="MARK_RAN">
