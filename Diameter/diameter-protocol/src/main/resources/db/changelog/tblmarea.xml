<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-tblmarea-001" author="initial-change">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tblmarea"/>
            </not>
        </preConditions>

        <createTable tableName="tblmarea">

            <column name="areaid" type="BIGINT">
                <constraints primaryKey="true"
                             nullable="false"
                             primaryKeyName="pk_tblmarea"/>
            </column>

            <column name="name" type="VARCHAR(100)"/>

            <column name="COUNTRYID" type="BIGINT"/>

            <column name="STATEID" type="BIGINT"/>

            <column name="is_deleted" type="TINYINT(1)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="createdbystaffid" type="DECIMAL(20,0)"/>

            <column name="createdate"
                    type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="lastmodifiedbystaffid" type="DECIMAL(20,0)"/>

            <column name="lastmodifieddate"
                    type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP"/>

            <column name="CITYID" type="BIGINT"/>

            <column name="status" type="VARCHAR(100)"/>

            <column name="pincodeid" type="BIGINT"/>

            <column name="MVNOID" type="BIGINT"/>

            <column name="createbyname" type="VARCHAR(100)"/>

            <column name="updatebyname" type="VARCHAR(100)"/>

        </createTable>


        <!-- Unique constraint -->
        <addUniqueConstraint
                tableName="tblmarea"
                columnNames="areaid"
                constraintName="marea_areaid_unq"/>


        <!-- Indexes -->
        <createIndex indexName="tblmarea_FK"
                     tableName="tblmarea">
            <column name="COUNTRYID"/>
        </createIndex>

        <createIndex indexName="tblmarea_FK_2"
                     tableName="tblmarea">
            <column name="STATEID"/>
        </createIndex>

        <createIndex indexName="tblmarea_FK_1"
                     tableName="tblmarea">
            <column name="CITYID"/>
        </createIndex>

        <createIndex indexName="tblmarea_ibfk_1"
                     tableName="tblmarea">
            <column name="MVNOID"/>
        </createIndex>

        <createIndex indexName="idx_area_pincodeid_deleted"
                     tableName="tblmarea">
            <column name="pincodeid"/>
            <column name="is_deleted"/>
        </createIndex>

        <createIndex indexName="idx_tblmarea_pincodeid"
                     tableName="tblmarea">
            <column name="pincodeid"/>
        </createIndex>


        <!-- Foreign Keys -->

        <addForeignKeyConstraint
                constraintName="tblmarea_FK"
                baseTableName="tblmarea"
                baseColumnNames="COUNTRYID"
                referencedTableName="tblmcountry"
                referencedColumnNames="countryid"
                onDelete="RESTRICT"
                onUpdate="RESTRICT"/>

        <addForeignKeyConstraint
                constraintName="tblmarea_FK_1"
                baseTableName="tblmarea"
                baseColumnNames="CITYID"
                referencedTableName="tblmcity"
                referencedColumnNames="cityid"
                onDelete="RESTRICT"
                onUpdate="RESTRICT"/>

        <addForeignKeyConstraint
                constraintName="tblmarea_FK_2"
                baseTableName="tblmarea"
                baseColumnNames="STATEID"
                referencedTableName="tblmstate"
                referencedColumnNames="stateid"
                onDelete="RESTRICT"
                onUpdate="RESTRICT"/>

        <addForeignKeyConstraint
                constraintName="tblmarea_FK_3"
                baseTableName="tblmarea"
                baseColumnNames="pincodeid"
                referencedTableName="tblmpincode"
                referencedColumnNames="pincodeid"
                onDelete="RESTRICT"
                onUpdate="RESTRICT"/>

        <addForeignKeyConstraint
                constraintName="tblmarea_ibfk_1"
                baseTableName="tblmarea"
                baseColumnNames="MVNOID"
                referencedTableName="tblmmvno"
                referencedColumnNames="MVNOID"
                onDelete="RESTRICT"
                onUpdate="RESTRICT"/>

    </changeSet>

</databaseChangeLog>