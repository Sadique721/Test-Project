<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-tbltcasmaster-001" author="initial-change">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tbltcasmaster"/>
            </not>
        </preConditions>


        <createTable tableName="tbltcasmaster">
            <column name="id" type="BIGINT" >
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="casname" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="is_deleted" type="TINYINT(1)">
                <constraints nullable="true"/>
            </column>
            <column name="BUID" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="MVNOID" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="CREATEDATE" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
            <column name="LASTMODIFIEDDATE" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
            <column name="createbyname" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="updatebyname" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="CREATEDBYSTAFFID" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="LASTMODIFIEDBYSTAFFID" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="endpointurl" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>