<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="tbltcustomerservicemapping-0001" author="Arpit">

        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <tableExists tableName="tbltcustomerservicemapping"/>
            </not>
        </preConditions>

        <createTable tableName="tbltcustomerservicemapping">

            <!-- ID (NO AUTO INCREMENT) -->
            <column name="id" type="int">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="custid" type="int"/>
            <column name="serviceid" type="bigint"/>
            <column name="leasecircuitid" type="bigint"/>
            <column name="connection_no" type="varchar(255)"/>
            <column name="nickname" type="varchar(255)"/>
            <column name="is_deleted" type="tinyint(1)" defaultValueNumeric="0"/>

            <column name="invoice_format" type="varchar(100)"/>
            <column name="invoice_type" type="varchar(100)"/>
            <column name="lease_circuit_name" type="varchar(255)"/>
            <column name="circuit_status" type="varchar(100)"/>
            <column name="caf_no" type="bigint"/>
            <column name="upload_caf" type="varchar(255)"/>
            <column name="customer_name" type="varchar(255)"/>
            <column name="account_number" type="bigint"/>
            <column name="type_of_link" type="varchar(100)"/>

            <column name="link_installation_date" type="date"/>
            <column name="link_acceptance_date" type="date"/>
            <column name="purchase_order_date" type="date"/>
            <column name="partner_id" type="bigint"/>
            <column name="expiry_date" type="date"/>
            <column name="distance" type="bigint"/>
            <column name="distance_unit" type="varchar(50)"/>
            <column name="bandwidth" type="bigint"/>

            <column name="uploadQOS" type="varchar(100)"/>
            <column name="downloadQOS" type="varchar(100)"/>
            <column name="link_router_location" type="varchar(255)"/>
            <column name="link_port_type" type="varchar(100)"/>
            <column name="link_router_ip" type="bigint"/>
            <column name="link_port_on_router" type="varchar(100)"/>
            <column name="vlan_id" type="bigint"/>
            <column name="bandwidth_type" type="varchar(100)"/>
            <column name="link_router_name" type="varchar(255)"/>
            <column name="circuit_billing_id" type="bigint"/>
            <column name="pop" type="varchar(100)"/>

            <column name="associated_level" type="varchar(100)"/>
            <column name="location_level1" type="varchar(255)"/>
            <column name="location_level2" type="varchar(255)"/>
            <column name="location_level3" type="varchar(255)"/>
            <column name="location_level4" type="varchar(255)"/>

            <column name="base_station_id1" type="bigint"/>
            <column name="base_station_id2" type="bigint"/>
            <column name="termination_address" type="varchar(500)"/>
            <column name="note" type="varchar(1000)"/>

            <column name="contact_person" type="varchar(255)"/>
            <column name="contact_person1" type="varchar(255)"/>
            <column name="mobile_number" type="varchar(50)"/>
            <column name="mobile_number1" type="varchar(50)"/>
            <column name="landline_number" type="varchar(50)"/>
            <column name="landline_number1" type="varchar(50)"/>
            <column name="email_id" type="varchar(255)"/>
            <column name="email_id1" type="varchar(255)"/>

            <column name="billing_cycle" type="varchar(50)"/>
            <column name="billing_type" type="varchar(50)"/>
            <column name="billable" type="varchar(50)"/>
            <column name="billing_group" type="varchar(100)"/>
            <column name="payable" type="varchar(50)"/>
            <column name="status" type="varchar(100)"/>

            <column name="enable_processing" type="varchar(50)"/>
            <column name="deposite" type="varchar(100)"/>
            <column name="po_number" type="varchar(100)"/>
            <column name="bill_remark" type="varchar(1000)"/>

            <column name="full_name" type="varchar(255)"/>
            <column name="organisation" type="varchar(255)"/>
            <column name="address1" type="varchar(255)"/>
            <column name="address2" type="varchar(255)"/>
            <column name="city" type="varchar(100)"/>
            <column name="zipcode" type="varchar(50)"/>
            <column name="state" type="varchar(100)"/>
            <column name="country" type="varchar(100)"/>

            <column name="MVNOID" type="int"/>
            <column name="buid" type="bigint"/>

            <column name="s_discount_type" type="varchar(50)"/>
            <column name="s_discount" type="decimal(20,4)"/>
            <column name="discount_expiry_date" type="date"/>
            <column name="new_discount_type" type="varchar(50)"/>
            <column name="new_discount" type="decimal(20,4)"/>
            <column name="new_discount_expiry_date" type="date"/>

            <column name="remarks" type="varchar(1000)"/>

            <column name="hold_service_date" type="datetime"/>
            <column name="resume_service_date" type="datetime"/>
            <column name="service_hold_by" type="varchar(255)"/>
            <column name="service_hold_remarks" type="varchar(1000)"/>
            <column name="service_resume_by" type="varchar(255)"/>
            <column name="service_resume_remarks" type="varchar(1000)"/>
            <column name="stop_service_remarks" type="varchar(1000)"/>

            <column name="discount_flow_in_process" type="varchar(100)"/>
            <column name="service_area_type" type="varchar(100)"/>
            <column name="branch" type="varchar(100)"/>
            <column name="connection_type" type="varchar(100)"/>
            <column name="next_team_hir_mapping" type="int"/>
            <column name="next_staff" type="int"/>

            <!-- Audit Fields -->
            <column name="CREATEDATE" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="LASTMODIFIEDDATE" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP"/>

            <column name="createbyname" type="varchar(40)"/>
            <column name="updatebyname" type="varchar(40)"/>
            <column name="CREATEDBYSTAFFID" type="int"/>
            <column name="LASTMODIFIEDBYSTAFFID" type="int"/>

        </createTable>
    </changeSet>

    <changeSet id="JPS0011052601" author="Jeel salvi" runOnChange="true">

        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="tbltcustomerservicemapping" columnName="msisdn"/>
            </not>
        </preConditions>

        <addColumn tableName="tbltcustomerservicemapping">
            <column name="msisdn" type="VARCHAR(255)"/>
        </addColumn>

    </changeSet>

    <changeSet id="JPS0011052602" author="Jeel salvi" runOnChange="true">

        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="tbltcustomerservicemapping" columnName="imsi"/>
            </not>
        </preConditions>

        <addColumn tableName="tbltcustomerservicemapping">
            <column name="imsi" type="VARCHAR(255)"/>
        </addColumn>

    </changeSet>

    <changeSet id="JPS0005062601" author="KTPL.INT0062" runOnChange="true">

        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="tbltcustomerservicemapping" columnName="username"/>
            </not>
        </preConditions>

        <addColumn tableName="tbltcustomerservicemapping">
            <column name="username" type="VARCHAR(255)"/>
        </addColumn>

    </changeSet>

    <changeSet id="JPS0005062602" author="KTPL.INT0062" runOnChange="true">

        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="tbltcustomerservicemapping" columnName="password"/>
            </not>
        </preConditions>

        <addColumn tableName="tbltcustomerservicemapping">
            <column name="password" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="RDK2606202601" author="Raj Kachhadiya">

        <preConditions onFail="MARK_RAN">
            <columnExists tableName="tbltcustomerservicemapping"
                          columnName="createbyname"/>
        </preConditions>

        <modifyDataType tableName="tbltcustomerservicemapping"
                        columnName="createbyname"
                        newDataType="VARCHAR(250)"/>

        <modifyDataType tableName="tbltcustomerservicemapping"
                        columnName="updatebyname"
                        newDataType="VARCHAR(250)"/>

    </changeSet>
    
</databaseChangeLog>