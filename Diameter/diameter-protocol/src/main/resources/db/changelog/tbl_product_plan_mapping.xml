<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-tbl-product-plan-mapping-001" author="initial-change">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tbl_product_plan_mapping"/>
            </not>
        </preConditions>

        <createTable tableName="tbl_product_plan_mapping">

            <column name="id" type="BIGINT" >
                <constraints primaryKey="true"
                             nullable="false"
                             primaryKeyName="pk_tbl_product_plan_mapping"/>
            </column>

            <column name="plan_id" type="BIGINT"/>

            <column name="product_category_id" type="BIGINT"/>

            <column name="product_type" type="VARCHAR(100)"/>

            <column name="CREATEDATE" type="TIMESTAMP"/>

            <column name="LASTMODIFIEDDATE" type="TIMESTAMP"/>

            <column name="createbyname" type="VARCHAR(100)"/>

            <column name="updatebyname" type="VARCHAR(100)"/>

            <column name="CREATEDBYSTAFFID" type="BIGINT"/>

            <column name="LASTMODIFIEDBYSTAFFID" type="BIGINT"/>

            <column name="product_id" type="BIGINT"/>

            <column name="revised_charge" type="VARCHAR(50)"/>

            <column name="ownership_type" type="VARCHAR(50)"/>

            <column name="name" type="VARCHAR(250)"/>

            <column name="product_quantity" type="BIGINT"/>

        </createTable>

    </changeSet>

</databaseChangeLog>