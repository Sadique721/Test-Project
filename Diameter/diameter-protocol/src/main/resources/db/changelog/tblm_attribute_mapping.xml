<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-tblm_attribute_mapping" author="auto-generated">
		<preConditions onFail="MARK_RAN" onError="MARK_RAN">
			<not>
				<tableExists tableName="tblm_attribute_mapping"/>
			</not>
		</preConditions>
          <createTable tableName="tblm_attribute_mapping">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="attribute_id" type="varchar(36)"/>
            <column name="vendor_id" type="varchar(36)"/>
        </createTable>
    </changeSet>
    <changeSet id="add-attribute-mapping-fks" author="yourname">
	    <addForeignKeyConstraint
	        baseTableName="tblm_attribute_mapping"
	        baseColumnNames="attribute_id"
	        referencedTableName="tblm_attribute"
	        referencedColumnNames="id"
	        constraintName="fk_attribute_mapping_attribute"
	        onDelete="CASCADE"/>
	
	    <addForeignKeyConstraint
	        baseTableName="tblm_attribute_mapping"
	        baseColumnNames="vendor_id"
	        referencedTableName="tblm_vendor_information"
	        referencedColumnNames="id"
	        constraintName="fk_attribute_mapping_vendor"
	        onDelete="CASCADE"/>
	</changeSet>

</databaseChangeLog>
