<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-tbltcustprofile-001" author="initial-change">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tbltcustprofile"/>
            </not>
        </preConditions>

        <createTable tableName="tbltcustprofile">

            <column name="profile_id" type="BIGINT" >
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_tbltcustprofile"/>
            </column>

            <column name="name" type="VARCHAR(255)"/>
            <column name="prefix" type="VARCHAR(255)"/>
            <column name="type" type="VARCHAR(255)"/>
            <column name="start_from" type="VARCHAR(255)"/>

            <column name="year" type="TINYINT(1)"/>
            <column name="month" type="TINYINT(1)"/>
            <column name="day" type="TINYINT(1)"/>

            <column name="status" type="VARCHAR(255)"/>

            <column name="is_delete" type="TINYINT(1)" defaultValueNumeric="0"/>

            <column name="mvno_id" type="BIGINT"/>

            <column name="createdate" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="lastmodifieddate" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>

            <column name="createbyname" type="VARCHAR(100)"/>
            <column name="updatebyname" type="VARCHAR(100)"/>

            <column name="createdbystaffid" type="BIGINT"/>
            <column name="lastmodifiedbystaffid" type="BIGINT"/>

        </createTable>

    </changeSet>

</databaseChangeLog>