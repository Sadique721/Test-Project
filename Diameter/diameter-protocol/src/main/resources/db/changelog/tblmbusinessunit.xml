<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-tblmbusinessunit-001" author="initial-change">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tblmbusinessunit"/>
            </not>
        </preConditions>

        <createTable tableName="tblmbusinessunit">

            <column name="businessunitid" type="BIGINT">
                <constraints primaryKey="true" nullable="false" unique="true"/>
            </column>
            <column name="buname" type="VARCHAR(100)"/>
            <column name="bucode" type="VARCHAR(100)"/>
            <column name="is_deleted" type="TINYINT(1)" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="createdbystaffid" type="DECIMAL(20,0)"/>
            <column name="createdate" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="lastmodifiedbystaffid" type="DECIMAL(20,0)"/>
            <column name="lastmodifieddate" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="status" type="VARCHAR(100)"/>
            <column name="MVNOID" type="BIGINT"/>
            <column name="plan_binding_type" type="VARCHAR(50)"/>
            <column name="createbyname" type="VARCHAR(100)"/>
            <column name="updatebyname" type="VARCHAR(100)"/>
        </createTable>

        <!-- Index -->
        <createIndex tableName="tblmbusinessunit" indexName="tblmbusinessunit_ibfk_1">
            <column name="MVNOID"/>
        </createIndex>

        <!-- Foreign Key Constraint -->
        <addForeignKeyConstraint constraintName="tblmbusinessunit_ibfk_1"
                                 baseTableName="tblmbusinessunit"
                                 baseColumnNames="MVNOID"
                                 referencedTableName="tblmmvno"
                                 referencedColumnNames="MVNOID"
                                 onDelete="RESTRICT"
                                 onUpdate="CASCADE"/>
    </changeSet>

</databaseChangeLog>