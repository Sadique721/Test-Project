<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
                        
       <changeSet id="create-tblm-packet-mapping-condition-table" author="vimal.makwana">
           <createTable tableName="tblm_packet_mapping_condition">
			    <column name="id" type="VARCHAR(100)">
			        <constraints primaryKey="true" nullable="false"/>
			    </column>
			
			    <column name="mapping_header_id" type="VARCHAR(100)">
			        <constraints nullable="false"/>
			    </column>
			
			    <column name="avp_code" type="INT">
			        <constraints nullable="false"/>
			    </column>
			
			    <column name="vendor_id" type="INT" defaultValueNumeric="0"/>
			
			    <column name="match_type" type="VARCHAR(50)">
			        <constraints nullable="false"/>
			    </column>
			
			    <column name="expected_value" type="VARCHAR(500)"/>
			
			    <column name="sequence" type="INT"/>
			
			    <column name="created_date" type="TIMESTAMP"/>
			    <column name="created_by" type="VARCHAR(100)"/>
			    <column name="modified_date" type="TIMESTAMP"/>
			    <column name="modified_by" type="VARCHAR(100)"/>
			</createTable>
       </changeSet>
       
                        
</databaseChangeLog>