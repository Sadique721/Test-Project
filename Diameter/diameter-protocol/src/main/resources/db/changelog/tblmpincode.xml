<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-tblmpincode-001" author="initial-change">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tblmpincode"/>
            </not>
        </preConditions>

        <createTable tableName="tblmpincode">

            <column name="pincodeid" type="BIGINT">
                <constraints primaryKey="true"
                             nullable="false"
                             primaryKeyName="pk_tblmpincode"/>
            </column>

            <column name="pincode" type="VARCHAR(50)"/>

            <column name="COUNTRYID" type="BIGINT"/>

            <column name="STATEID" type="BIGINT"/>

            <column name="CITYID" type="BIGINT"/>

            <column name="is_deleted"
                    type="TINYINT(1)"
                    defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="createdbystaffid" type="DECIMAL(20,0)"/>

            <column name="createdate"
                    type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="lastmodifiedbystaffid" type="DECIMAL(20,0)"/>

            <column name="lastmodifieddate"
                    type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP"/>

            <column name="status" type="VARCHAR(100)"/>

            <column name="MVNOID" type="BIGINT"/>

            <column name="createbyname" type="VARCHAR(100)"/>

            <column name="updatebyname" type="VARCHAR(100)"/>

        </createTable>


        <!-- Unique constraint -->
        <addUniqueConstraint
                tableName="tblmpincode"
                columnNames="pincodeid"
                constraintName="mpincode_id_unq"/>


        <!-- Indexes -->
        <createIndex indexName="tblmpincode_FK"
                     tableName="tblmpincode">
            <column name="COUNTRYID"/>
        </createIndex>

        <createIndex indexName="tblmpincode_FK_2"
                     tableName="tblmpincode">
            <column name="STATEID"/>
        </createIndex>

        <createIndex indexName="tblmpincode_ibfk_1"
                     tableName="tblmpincode">
            <column name="MVNOID"/>
        </createIndex>

        <createIndex indexName="idx_pincode_cityid_deleted"
                     tableName="tblmpincode">
            <column name="CITYID"/>
            <column name="is_deleted"/>
        </createIndex>


        <!-- Foreign Keys -->

        <addForeignKeyConstraint
                constraintName="tblmpincode_FK"
                baseTableName="tblmpincode"
                baseColumnNames="COUNTRYID"
                referencedTableName="tblmcountry"
                referencedColumnNames="countryid"
                onDelete="RESTRICT"
                onUpdate="RESTRICT"/>

        <addForeignKeyConstraint
                constraintName="tblmpincode_FK_1"
                baseTableName="tblmpincode"
                baseColumnNames="CITYID"
                referencedTableName="tblmcity"
                referencedColumnNames="cityid"
                onDelete="RESTRICT"
                onUpdate="RESTRICT"/>

        <addForeignKeyConstraint
                constraintName="tblmpincode_FK_2"
                baseTableName="tblmpincode"
                baseColumnNames="STATEID"
                referencedTableName="tblmstate"
                referencedColumnNames="stateid"
                onDelete="RESTRICT"
                onUpdate="RESTRICT"/>

        <addForeignKeyConstraint
                constraintName="tblmpincode_ibfk_1"
                baseTableName="tblmpincode"
                baseColumnNames="MVNOID"
                referencedTableName="tblmmvno"
                referencedColumnNames="MVNOID"
                onDelete="RESTRICT"
                onUpdate="RESTRICT"/>

    </changeSet>

</databaseChangeLog>