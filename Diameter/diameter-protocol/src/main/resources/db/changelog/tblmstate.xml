<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-tblmstate-001" author="initial-change">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tblmstate"/>
            </not>
        </preConditions>

        <createTable tableName="tblmstate">

            <column name="stateid" type="BIGINT">
                <constraints primaryKey="true"
                             nullable="false"
                             primaryKeyName="pk_tblmstate"/>
            </column>

            <column name="NAME" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>

            <column name="COUNTRYID" type="DECIMAL(20,0)"/>

            <column name="status" type="VARCHAR(50)"/>

            <column name="CREATEDATE"
                    type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="CREATEDBYSTAFFID" type="DECIMAL(20,0)"/>

            <column name="LASTMODIFIEDBYSTAFFID" type="DECIMAL(20,0)"/>

            <column name="LASTMODIFIEDDATE"
                    type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="is_deleted"
                    type="TINYINT(1)"
                    defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="createbyname" type="VARCHAR(100)"/>

            <column name="updatebyname" type="VARCHAR(100)"/>

            <column name="MVNOID" type="BIGINT"/>

        </createTable>


        <!-- Unique constraint -->
        <addUniqueConstraint
                tableName="tblmstate"
                columnNames="stateid"
                constraintName="mstate_stateId_unq"/>


        <!-- Index on MVNOID -->
        <createIndex indexName="TBLMSTATE_ibfk_1"
                     tableName="tblmstate">
            <column name="MVNOID"/>
        </createIndex>


        <!-- Composite index (COUNTRYID, is_deleted) -->
        <createIndex indexName="idx_state_countryid_deleted"
                     tableName="tblmstate">
            <column name="COUNTRYID"/>
            <column name="is_deleted"/>
        </createIndex>


        <!-- FK to tblmmvno -->
        <addForeignKeyConstraint
                constraintName="TBLMSTATE_ibfk_1"
                baseTableName="tblmstate"
                baseColumnNames="MVNOID"
                referencedTableName="tblmmvno"
                referencedColumnNames="MVNOID"
                onDelete="RESTRICT"
                onUpdate="RESTRICT"/>

    </changeSet>

</databaseChangeLog>