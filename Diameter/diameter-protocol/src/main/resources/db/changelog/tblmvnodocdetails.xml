<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-tblmvnodocdetails-001" author="initial-change">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tblmvnodocdetails"/>
            </not>
        </preConditions>

        <createTable tableName="tblmvnodocdetails">

            <column name="doc_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_tblmvnodocdetails"/>
            </column>

            <column name="doc_type" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="doc_status" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="MVNOID" type="BIGINT"/>

            <column name="filename" type="VARCHAR(200)"/>
            <column name="uniquename" type="VARCHAR(200)"/>
            <column name="doc_sub_type" type="VARCHAR(100)"/>
            <column name="mode" type="VARCHAR(100)"/>
            <column name="remark" type="VARCHAR(100)"/>
            <column name="createbyname" type="VARCHAR(100)"/>
            <column name="updatebyname" type="VARCHAR(100)"/>

            <column name="next_team_hir_mapping" type="BIGINT"/>
            <column name="next_staff" type="BIGINT"/>

            <column name="startdate" type="DATETIME"/>
            <column name="enddate" type="DATETIME"/>

            <column name="is_delete" type="TINYINT(1)">
                <constraints nullable="false"/>
            </column>

            <column name="CREATEDATE" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="LASTMODIFIEDDATE" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="CREATEDBYSTAFFID" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="LASTMODIFIEDBYSTAFFID" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <!-- Unique Constraint -->
        <addUniqueConstraint
                tableName="tblmvnodocdetails"
                columnNames="doc_id"
                constraintName="custdocdetails_doc_id_unq"/>

    </changeSet>

</databaseChangeLog>