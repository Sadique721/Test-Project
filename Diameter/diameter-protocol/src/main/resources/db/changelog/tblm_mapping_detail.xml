<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- Create mapping_detail table -->
    <changeSet id="create-tblm_packet_mapping_detail_table" author="auto-generated">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <not>
                <tableExists tableName="tblm_packet_mapping_detail"/>
            </not>
        </preConditions>
        <createTable tableName="tblm_packet_mapping_detail">
            <column name="id" type="VARCHAR(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="mapping_header_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="request_avp" type="VARCHAR(255)"/>
            <column name="response_avp" type="VARCHAR(100)"/>
            <column name="value_expression" type="VARCHAR(1000)"/>
            <column name="value_type" type="VARCHAR(255)"/>
            <column name="sequence" type="INT"/>
            <column name="mandatory" type="boolean" defaultValueBoolean="true">
	            <constraints nullable="false"/>
	        </column>
            <column name="created_date" type="TIMESTAMP"/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="modified_date" type="TIMESTAMP"/>
            <column name="modified_by" type="VARCHAR(100)"/>
        </createTable>

        <!-- Foreign key to mapping_header -->
        <addForeignKeyConstraint
                baseTableName="tblm_packet_mapping_detail"
                baseColumnNames="mapping_header_id"
                referencedTableName="tblm_packet_mapping_header"
                referencedColumnNames="id"
                constraintName="fk_tblm_packet_mapping_header_detail"/>
    </changeSet>
    
    <changeSet id="addColumn_vendor_id_packet_detail" author="auto-generated">
	    <addColumn tableName="tblm_packet_mapping_detail">
	        <column name="vendor_id" type="INT">
	            <constraints nullable="false"/>
	        </column>
	    </addColumn>
	</changeSet>

</databaseChangeLog>