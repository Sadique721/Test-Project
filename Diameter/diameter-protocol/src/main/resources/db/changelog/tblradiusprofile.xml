<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-tblradiusprofile-001" author="initial-change">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tblradiusprofile"/>
            </not>
        </preConditions>

        <!-- Create Table -->
        <createTable tableName="tblradiusprofile">

            <column name="radiusprofileid" type="BIGINT">
                <constraints primaryKey="true"
                             primaryKeyName="radiusprofile_radiusprofileid_unq"
                             nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="status" type="VARCHAR(1)">
                <constraints nullable="false"/>
            </column>

            <column name="is_delete" type="TINYINT(1)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="createbyname" type="VARCHAR(100)"/>
            <column name="updatebyname" type="VARCHAR(100)"/>

            <column name="CREATEDBYSTAFFID" type="DECIMAL(20,0)" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>

            <column name="LASTMODIFIEDBYSTAFFID" type="DECIMAL(20,0)" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>

            <column name="createdate" type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="lastmodifieddate" type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP"/>

            <column name="MVNOID" type="BIGINT"/>

        </createTable>


        <!-- Index for MVNOID -->
        <createIndex
                tableName="tblradiusprofile"
                indexName="tblradiusprofile_ibfk_1">
            <column name="MVNOID"/>
        </createIndex>


        <!-- Foreign Key -->
        <addForeignKeyConstraint
                baseTableName="tblradiusprofile"
                baseColumnNames="MVNOID"
                constraintName="tblradiusprofile_ibfk_1"
                referencedTableName="tblmmvno"
                referencedColumnNames="MVNOID"/>

    </changeSet>

</databaseChangeLog>