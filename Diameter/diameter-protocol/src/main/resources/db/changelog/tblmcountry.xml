<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-tblmcountry-001" author="initial-change">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tblmcountry"/>
            </not>
        </preConditions>

        <createTable tableName="tblmcountry">

            <column name="countryid" type="BIGINT">
                <constraints primaryKey="true"
                             nullable="false"
                             primaryKeyName="pk_tblmcountry"/>
            </column>

            <column name="NAME" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>

            <column name="status" type="VARCHAR(50)"/>

            <column name="CREATEDATE"
                    type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="CREATEDBYSTAFFID" type="DECIMAL(20,0)"/>

            <column name="LASTMODIFIEDBYSTAFFID" type="DECIMAL(20,0)"/>

            <column name="LASTMODIFIEDDATE"
                    type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP"/>

            <column name="is_delete"
                    type="TINYINT(1)"
                    defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="MVNOID" type="BIGINT"/>

            <column name="createbyname" type="VARCHAR(100)"/>

            <column name="updatebyname" type="VARCHAR(100)"/>

        </createTable>


        <!-- Unique constraint -->
        <addUniqueConstraint
                tableName="tblmcountry"
                columnNames="countryid"
                constraintName="mcountry_countryId_unq"/>


        <!-- Index on MVNOID -->
        <createIndex
                indexName="TBLMCOUNTRY_ibfk_1"
                tableName="tblmcountry">
            <column name="MVNOID"/>
        </createIndex>


        <!-- Foreign Key to tblmmvno -->
        <addForeignKeyConstraint
                constraintName="TBLMCOUNTRY_ibfk_1"
                baseTableName="tblmcountry"
                baseColumnNames="MVNOID"
                referencedTableName="tblmmvno"
                referencedColumnNames="MVNOID"
                onDelete="RESTRICT"
                onUpdate="RESTRICT"/>

    </changeSet>

</databaseChangeLog>