<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
        
    <changeSet id="add-pk-databasechangelog" author="auto-fix">
	    
	    <preConditions onFail="MARK_RAN">
	        <not>
	            <primaryKeyExists
	                tableName="DATABASECHANGELOG"
	                primaryKeyName="PRIMARY"/>
	        </not>
	    </preConditions>
	
	    <addPrimaryKey
	        tableName="DATABASECHANGELOG"
	        columnNames="ID, AUTHOR, FILENAME"
	        constraintName="PRIMARY"/>
	</changeSet>
    

    <changeSet id="create-tbl_qos_policy" author="auto-generated">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <not>
                <tableExists tableName="tbl_qos_policy"/>
            </not>
        </preConditions>
        <createTable tableName="tbl_qos_policy">
            <column name="id" type="bigint">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_tbl_qos_policy"/>
            </column>
            <column name="name" type="varchar(100)"/>
            <column name="description" type="varchar(100)"/>
            <column name="thpolicyname" type="varchar(100)"/>
            <column name="baseparam1" type="varchar(100)"/>
            <column name="baseparam2" type="varchar(100)"/>
            <column name="baseparam3" type="varchar(100)"/>
            <column name="thparam1" type="varchar(100)"/>
            <column name="thparam2" type="varchar(100)"/>
            <column name="thparam3" type="varchar(100)"/>
            <column name="is_deleted" type="tinyint(1)"/>
            <column name="createdbystaffid" type="decimal(20,0)"/>
            <column name="createdate" type="timestamp"/>
            <column name="lastmodifiedbystaffid" type="decimal(20,0)"/>
            <column name="lastmodifieddate" type="timestamp"/>
            <column name="basepolicyname" type="varchar(100)"/>
            <column name="createbyname" type="varchar(100)"/>
            <column name="updatebyname" type="varchar(100)"/>
            <column name="MVNOID" type="bigint"/>
            <column name="type" type="varchar(150)"/>
            <column name="qosspeed" type="varchar(250)"/>
            <column name="upstreamprofileuid" type="varchar(150)"/>
            <column name="downstreamprofileuid" type="varchar(150)"/>
        </createTable>

        <!-- Optional: Add unique constraint if needed -->
        
        <addUniqueConstraint columnNames="name" tableName="tbl_qos_policy" constraintName="uq_tbl_qos_policy_name"/>

    </changeSet>

    <changeSet id="alter-qos-policy-id-autoincrement" author="auto-generated">
        <modifyDataType tableName="tbl_qos_policy"
                        columnName="id"
                        newDataType="bigint auto_increment"/>
    </changeSet>

</databaseChangeLog>
