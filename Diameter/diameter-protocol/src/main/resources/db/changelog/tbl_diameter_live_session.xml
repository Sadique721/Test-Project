        <modifyDataType tableName="tbl_diameter_live_session"
                        columnName="CC_REQUEST_TYPE"
                        newDataType="VARCHAR(512)"/>

        <modifyDataType tableName="tbl_diameter_live_session"
                        columnName="DIAMETER_INTERFACE"
                        newDataType="VARCHAR(512)"/>

        <modifyDataType tableName="tbl_diameter_live_session"
                        columnName="SERVICE_TYPE"
                        newDataType="VARCHAR(512)"/>

        <modifyDataType tableName="tbl_diameter_live_session"
                        columnName="SERVICE_CONTEXT_ID"
                        newDataType="VARCHAR(512)"/>

        <!-- SUBSCRIBER DETAILS -->

        <modifyDataType tableName="tbl_diameter_live_session"
                        columnName="MSISDN"
                        newDataType="VARCHAR(512)"/>

        <modifyDataType tableName="tbl_diameter_live_session"
                        columnName="IMSI"
                        newDataType="VARCHAR(512)"/>

        <modifyDataType tableName="tbl_diameter_live_session"
                        columnName="IMEI"
                        newDataType="VARCHAR(512)"/>

        <modifyDataType tableName="tbl_diameter_live_session"
                        columnName="CALLING_PARTY"
                        newDataType="VARCHAR(512)"/>

        <modifyDataType tableName="tbl_diameter_live_session"
                        columnName="CALLED_PARTY"
                        newDataType="VARCHAR(512)"/>

        <!-- NETWORK DETAILS -->

        <modifyDataType tableName="tbl_diameter_live_session"
                        columnName="IP_ADDRESS"
                        newDataType="VARCHAR(512)"/>

        <modifyDataType tableName="tbl_diameter_live_session"
                        columnName="APN"
                        newDataType="VARCHAR(512)"/>

        <modifyDataType tableName="tbl_diameter_live_session"
                        columnName="ORIGIN_HOST"
                        newDataType="VARCHAR(512)"/>

        <modifyDataType tableName="tbl_diameter_live_session"
                        columnName="ORIGIN_REALM"
                        newDataType="VARCHAR(512)"/>

        <modifyDataType tableName="tbl_diameter_live_session"
                        columnName="DESTINATION_HOST"
                        newDataType="VARCHAR(512)"/>

        <modifyDataType tableName="tbl_diameter_live_session"
                        columnName="DESTINATION_REALM"
                        newDataType="VARCHAR(512)"/>

        <!-- RX / IMS DETAILS -->

        <modifyDataType tableName="tbl_diameter_live_session"
                        columnName="MEDIA_TYPE"
                        newDataType="VARCHAR(512)"/>

        <modifyDataType tableName="tbl_diameter_live_session"
                        columnName="SIP_METHOD"
                        newDataType="VARCHAR(512)"/>

        <modifyDataType tableName="tbl_diameter_live_session"
                        columnName="AF_CHARGING_IDENTIFIER"
                        newDataType="VARCHAR(512)"/>

        <modifyDataType tableName="tbl_diameter_live_session"
                        columnName="FLOW_STATUS"
                        newDataType="VARCHAR(512)"/>

        <modifyDataType tableName="tbl_diameter_live_session"
                        columnName="CODEC"
                        newDataType="VARCHAR(512)"/>

        <!-- POLICY / PCC -->

        <modifyDataType tableName="tbl_diameter_live_session"
                        columnName="POLICY_NAME"
                        newDataType="VARCHAR(512)"/>

        <modifyDataType tableName="tbl_diameter_live_session"
                        columnName="CHARGING_RULE_BASE_NAME"
                        newDataType="VARCHAR(512)"/>

        <modifyDataType tableName="tbl_diameter_live_session"
                        columnName="QOS_PROFILE"
                        newDataType="VARCHAR(512)"/>

        <!-- SESSION STATUS -->

        <modifyDataType tableName="tbl_diameter_live_session"
                        columnName="SESSION_STATUS"
                        newDataType="VARCHAR(512)"/>

        <modifyDataType tableName="tbl_diameter_live_session"
                        columnName="STATUS"
                        newDataType="VARCHAR(512)"/>

        <!-- AUDIT -->

        <modifyDataType tableName="tbl_diameter_live_session"
                        columnName="NODE_NAME"
                        newDataType="VARCHAR(512)"/>

        <modifyDataType tableName="tbl_diameter_live_session"
                        columnName="POD_NAME"
                        newDataType="VARCHAR(512)"/>

    </changeSet>


    <!-- ========================================================= -->
    <!-- LIVE SESSION : NAS IP / IP DETAILS / PLAN DETAILS         -->
    <!-- ========================================================= -->
    <changeSet id="alter_tbl_diameter_live_session_add_plan_fields"
               author="Vimal Makwana">

        <preConditions onFail="MARK_RAN"
                       onError="MARK_RAN">

            <and>
                <not>
                    <columnExists tableName="tbl_diameter_live_session"
                                  columnName="NAS_IP_ADDRESS"/>
                </not>

                <not>
                    <columnExists tableName="tbl_diameter_live_session"
                                  columnName="IPV4_ADDRESS"/>
                </not>

                <not>
                    <columnExists tableName="tbl_diameter_live_session"
                                  columnName="IPV6_ADDRESS"/>
                </not>

                <not>
                    <columnExists tableName="tbl_diameter_live_session"
                                  columnName="CURRENT_PLAN"/>
                </not>

                <not>
                    <columnExists tableName="tbl_diameter_live_session"
                                  columnName="PLAN_START_DATE"/>
                </not>

                <not>
                    <columnExists tableName="tbl_diameter_live_session"
                                  columnName="PLAN_EXPIRY_DATE"/>
                </not>

            </and>

        </preConditions>

        <addColumn tableName="tbl_diameter_live_session">

            <column name="NAS_IP_ADDRESS"
                    type="VARCHAR(512)"/>

            <column name="IPV4_ADDRESS"
                    type="VARCHAR(50)"/>

            <column name="IPV6_ADDRESS"
                    type="VARCHAR(100)"/>

            <column name="CURRENT_PLAN"
                    type="VARCHAR(512)"/>

            <column name="PLAN_START_DATE"
                    type="TIMESTAMP"/>

            <column name="PLAN_EXPIRY_DATE"
                    type="TIMESTAMP"/>

        </addColumn>

    </changeSet>
    
    <changeSet id="add-geo-fields-to-diameter_live_session" author="Vimal Makwana">
	    <addColumn tableName="tbl_diameter_live_session">
	
	        <column name="geo_type" type="VARCHAR(25)">
	            <constraints nullable="true"/>
	        </column>
	
	        <column name="mcc" type="VARCHAR(25)">
	            <constraints nullable="true"/>
	        </column>
	
	        <column name="mnc" type="VARCHAR(25)">
	            <constraints nullable="true"/>
	        </column>
	
	        <column name="tac" type="VARCHAR(25)">
	            <constraints nullable="true"/>
	        </column>
	
	        <column name="eci" type="VARCHAR(25)">
	            <constraints nullable="true"/>
	        </column>
	
	        <column name="enodeb_id" type="VARCHAR(25)">
	            <constraints nullable="true"/>
	        </column>
	
	        <column name="cell_id" type="VARCHAR(25)">
	            <constraints nullable="true"/>
	        </column>
	
	    </addColumn>
	</changeSet>

</databaseChangeLog>