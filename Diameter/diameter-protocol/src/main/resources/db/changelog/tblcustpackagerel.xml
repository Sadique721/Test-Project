            <column name="customer_cpr" type="INT"/>
            <column name="is_hold" type="TINYINT(1)" defaultValueNumeric="0"/>
            <column name="service_id" type="INT"/>
        </addColumn>
    </changeSet>
    
</databaseChangeLog>