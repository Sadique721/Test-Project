	        columnName="status" 
	        newDataType="varchar(150)" />
	</changeSet>
    <changeSet id="create-tblcustpackagerel-001" author="Arpit Raval">
        <addColumn tableName="tblcustpackagerel">
            <column name="plangroupid" type="BIGINT"/>
            <column name="custservicemappingid" type="BIGINT"/>
            <column name="bill_to" type="VARCHAR(25)" defaultValue="CUSTOMER"/>
