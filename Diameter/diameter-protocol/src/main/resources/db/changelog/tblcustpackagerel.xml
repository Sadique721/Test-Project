            <column name="custid" type="bigint"/>
            <column name="planid" type="bigint"/>
            <column name="startdate" type="timestamp"/>
            <column name="enddate" type="timestamp"/>
            <column name="expirydate" type="timestamp"/>
            <column name="status" type="char(1)"/>
            <column name="service" type="varchar(100)"/>
            <column name="qospolicyid" type="bigint"/>
            <column name="uploadqos" type="varchar(120)"/>
            <column name="downloadqos" type="varchar(120)"/>
            <column name="uploadts" type="varchar(120)"/>
            <column name="downloadts" type="varchar(120)"/>
            <column name="createdbystaffid" type="decimal(20,0)"/>
            <column name="createdate" type="timestamp"/>
            <column name="lastmodifiedbystaffid" type="decimal(20,0)"/>
            <column name="lastmodifieddate" type="timestamp"/>
            <column name="is_delete" type="tinyint(1)"/>
