            <column name="wallet_bal_used" type="double"/>
            <column name="purchase_type" type="varchar(100)"/>
            <column name="online_purchase_id" type="bigint"/>
            <column name="purchase_from" type="varchar(100)"/>
            <column name="grace_days" type="bigint"/>
            <column name="cust_plan_status" type="varchar(50)"/>
            <column name="notificationlevel" type="bigint"/>
            <column name="istriggercoadm" type="bit(1)"/>
            <column name="onquotaexhausteventname" type="varchar(100)"/>
        </createTable>

        <!-- Add composite unique constraint -->
        <addUniqueConstraint 
            tableName="tblcustpackagerel"
            columnNames="custid, planid, custpackageid"
            constraintName="uq_custid_planid_custpackageid"/>

        <!-- Add index on (custid, status, purchase_type) -->
        <createIndex 
            tableName="tblcustpackagerel"
            indexName="idx_custpackagerel_custid_status_purchase">
            <column name="custid"/>
            <column name="status"/>
            <column name="purchase_type"/>
        </createIndex>

    </changeSet>
    
    <changeSet id="modify-status-column_tblcustpackagerel" author="auto-generated">
	    <modifyDataType 
