<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-tblm_attribute" author="auto-generated">
        <preConditions onFail="MARK_RAN" onError="MARK_RAN">
            <not>
                <tableExists tableName="tblm_attribute"/>
            </not>
        </preConditions>
        <createTable tableName="tblm_attribute">
            <column name="id" type="varchar(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="attribute_id" type="int"/>
            <column name="name" type="varchar(255)"/>
            <column name="mandatory" type="varchar(3)"/>
            <column name="protected" type="varchar(3)"/>
            <column name="encryption" type="varchar(3)"/>
            <column name="type" type="varchar(50)"/>
            <column name="status" type="varchar(20)"/>
            <column name="dictionary_type" type="varchar(50)"/>
            <column name="minimum" type="int"/>
            <column name="maximum" type="int"/>
            <column name="attribute_vendor_id" type="int"/>
            <column name="parent_attribute_id" type="varchar(36)"/>
            <column name="vendor_id" type="varchar(500)"/>
            <column name="created_date" type="datetime"/>
            <column name="created_by" type="varchar(255)"/>
            <column name="modified_date" type="datetime"/>
            <column name="modified_by" type="varchar(255)"/>
            <column name="regex" type="varchar(500)"/>
        </createTable>
    </changeSet>

    <changeSet id="add-fk-tblm_attribute" author="auto-generated">
        <!--<addForeignKeyConstraint 
            baseTableName="tblm_attribute"
            baseColumnNames="vendor_id"
            referencedTableName="tblm_vendor_information"
