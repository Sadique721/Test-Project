            constraintName="fk_tblm_attribute_vendor_info"/>-->

        <addForeignKeyConstraint 
            baseTableName="tblm_attribute"
            baseColumnNames="parent_attribute_id"
            referencedTableName="tblm_attribute"
            referencedColumnNames="id"
            constraintName="fk_tblm_attribute_parent"/>
    </changeSet>

    <changeSet id="create-index-tblm_attribute" author="auto-generated">
