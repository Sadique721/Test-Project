<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-tblmservices-001" author="initial-change">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tblmservices"/>
            </not>
        </preConditions>

        <createTable tableName="tblmservices">
            <column name="serviceid" type="BIGINT" >
                <constraints primaryKey="true" nullable="false" unique="true" />
            </column>
            <column name="servicename" type="VARCHAR(255)" />
            <column name="CREATEDATE" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="CREATEDBYSTAFFID" type="DECIMAL(20,0)" />
            <column name="LASTMODIFIEDBYSTAFFID" type="DECIMAL(20,0)" />
            <column name="LASTMODIFIEDDATE" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP" />
            <column name="createbyname" type="VARCHAR(100)" />
            <column name="updatebyname" type="VARCHAR(100)" />
            <column name="MVNOID" type="BIGINT" />
            <column name="icname" type="VARCHAR(100)" />
            <column name="iccode" type="VARCHAR(100)" />
            <column name="BUID" type="BIGINT" />
            <column name="is_qosv" type="BIT(1)" defaultValueBoolean="true" />
            <column name="expiry" type="VARCHAR(255)" />
            <column name="ledger_id" type="VARCHAR(100)" />
            <column name="is_dtv" type="BIT(1)" />
            <column name="investmentcode_id" type="BIGINT" />
            <column name="feasibility" type="TINYINT" />
            <column name="poc" type="TINYINT" />
            <column name="installation" type="TINYINT" />
            <column name="provisioning" type="TINYINT" />
            <column name="is_price_editable" type="TINYINT" />
            <column name="feasibility_team_id" type="BIGINT" />
            <column name="poc_team_id" type="BIGINT" />
            <column name="installation_team_id" type="BIGINT" />
            <column name="provisioning_team_id" type="BIGINT" />
            <column name="displayname" type="VARCHAR(250)" />
            <column name="is_service_through_lead" type="BIT(1)" />
            <column name="is_deleted" type="TINYINT" defaultValueNumeric="0" />
            <column name="mvno_name" type="VARCHAR(150)" />
        </createTable>

        <!-- Indexes -->
        <createIndex indexName="TBLMSERVICES_businessunitid_FK_1" tableName="tblmservices">
            <column name="BUID"/>
        </createIndex>
        <createIndex indexName="tblmservices_ibfk_1" tableName="tblmservices">
            <column name="MVNOID"/>
        </createIndex>

        <!-- Foreign Key -->
        <addForeignKeyConstraint
                baseTableName="tblmservices"
                baseColumnNames="MVNOID"
                constraintName="tblmservices_ibfk_1"
                referencedTableName="tblmmvno"
                referencedColumnNames="MVNOID"
                deferrable="false"
                initiallyDeferred="false"
                onDelete="NO ACTION"/>
    </changeSet>

</databaseChangeLog>