<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="tbl_diameter_audit_001" author="auto-generated">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tbl_diameter_audit"/>
            </not>
        </preConditions>

        <createTable tableName="tbl_diameter_audit">

            <!-- Primary Key -->
            <column name="ID"
                    type="BIGINT"
                    autoIncrement="true">
                <constraints primaryKey="true"
                             nullable="false"/>
            </column>

            <!-- Correlation -->
            <column name="TRANSACTION_ID"
                    type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="SESSION_ID"
                    type="VARCHAR(255)"/>

            <!-- Diameter Info -->
            <column name="PROTOCOL" type="VARCHAR(20)"/>

            <column name="COMMAND_CODE" type="INT"/>

            <column name="APPLICATION_ID" type="BIGINT"/>

            <column name="REQUEST_TYPE" type="VARCHAR(30)"/>

            <column name="SERVICE_TYPE" type="VARCHAR(50)"/>

            <!-- Subscriber -->
            <column name="MSISDN" type="VARCHAR(30)"/>

            <column name="IMSI" type="VARCHAR(30)"/>

            <column name="IMEI" type="VARCHAR(30)"/>

            <column name="APN" type="VARCHAR(150)"/>

            <!-- Network -->
            <column name="ORIGIN_HOST" type="VARCHAR(150)"/>

            <column name="ORIGIN_REALM" type="VARCHAR(150)"/>

            <column name="DESTINATION_HOST" type="VARCHAR(150)"/>

            <column name="DESTINATION_REALM" type="VARCHAR(150)"/>

            <!-- Result -->
            <column name="RESULT_CODE" type="INT"/>

            <column name="RESULT_DESCRIPTION" type="VARCHAR(255)"/>

            <column name="STATUS" type="VARCHAR(20)"/>

            <column name="ERROR_MESSAGE" type="TEXT"/>

            <!-- Performance -->
            <column name="PROCESSING_TIME_MS" type="BIGINT"/>

            <!-- Payload -->
            <column name="REQUEST_PAYLOAD" type="TEXT"/>

            <column name="RESPONSE_PAYLOAD" type="TEXT"/>

            <!-- Infra -->
            <column name="PEER_NAME" type="VARCHAR(100)"/>

            <column name="POD_NAME" type="VARCHAR(100)"/>

            <!-- Audit -->
            <column name="CREATED_AT" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <!-- Indexes -->

        <createIndex tableName="tbl_diameter_audit"
                     indexName="idx_diameter_txn_id">
            <column name="TRANSACTION_ID"/>
        </createIndex>

        <createIndex tableName="tbl_diameter_audit"
                     indexName="idx_diameter_session_id">
            <column name="SESSION_ID"/>
        </createIndex>

        <createIndex tableName="tbl_diameter_audit"
                     indexName="idx_diameter_msisdn">
            <column name="MSISDN"/>
        </createIndex>

        <createIndex tableName="tbl_diameter_audit"
                     indexName="idx_diameter_imsi">
            <column name="IMSI"/>
        </createIndex>

        <createIndex tableName="tbl_diameter_audit"
                     indexName="idx_diameter_result_code">
            <column name="RESULT_CODE"/>
        </createIndex>

        <createIndex tableName="tbl_diameter_audit"
                     indexName="idx_diameter_created_at">
            <column name="CREATED_AT"/>
        </createIndex>

        <createIndex tableName="tbl_diameter_audit"
                     indexName="idx_diameter_status">
            <column name="STATUS"/>
        </createIndex>

    </changeSet>

