<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-tblmmvno-001" author="initial-change">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tblmmvno"/>
            </not>
        </preConditions>

        <createTable tableName="tblmmvno">

            <column name="MVNOID" type="BIGINT">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_tblmmvno"/>
            </column>

            <column name="NAME" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>

            <column name="SUFFIX" type="VARCHAR(16)"/>
            <column name="DESCRIPTION" type="VARCHAR(255)"/>
            <column name="EMAIL" type="VARCHAR(255)"/>
            <column name="PHONE" type="VARCHAR(255)"/>
            <column name="ADDRESS" type="VARCHAR(255)"/>
            <column name="STATUS" type="VARCHAR(40)"/>
            <column name="LOGOFILE" type="VARCHAR(255)"/>
            <column name="MVNOHEADER" type="VARCHAR(255)"/>
            <column name="MVNOFOOTER" type="VARCHAR(255)"/>

            <column name="CREATEDATE" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="LASTMODIFIEDDATE" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>

            <column name="CREATEDBYSTAFFID" type="BIGINT"/>
            <column name="LASTMODIFIEDBYSTAFFID" type="BIGINT"/>

            <column name="is_delete" type="TINYINT(1)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="USERNAME" type="VARCHAR(200)"/>
            <column name="PASSWORD" type="VARCHAR(200)"/>
            <column name="full_name" type="VARCHAR(255)"/>

            <column name="profile_id" type="BIGINT"/>
            <column name="threshold" type="BIGINT"/>
            <column name="cust_invoice_ref_id" type="BIGINT"/>

            <column name="mvno_deactivation_flag" type="BIT(1)"/>

            <column name="logo_image" type="LONGBLOB"/>
            <column name="logo_file_name" type="VARCHAR(50)"/>

            <column name="mvno_payment_due_days" type="BIGINT" defaultValueNumeric="10"/>
            <column name="isp_bill_day" type="BIGINT" defaultValueNumeric="1"/>
            <column name="isp_commission_percentage" type="DECIMAL(16,2)" defaultValueNumeric="100.00"/>

            <column name="bill_type" type="VARCHAR(250)"/>

        </createTable>

        <!-- Unique Constraint -->
        <addUniqueConstraint
                tableName="tblmmvno"
                columnNames="MVNOID"
                constraintName="mmvno_Id_unq"/>

        <!-- Index -->
        <createIndex
                indexName="tblmmvno_tbltcustprofile_fk"
                tableName="tblmmvno">
            <column name="profile_id"/>
        </createIndex>

        <!-- Foreign Key -->
        <addForeignKeyConstraint
                constraintName="tblmmvno_tbltcustprofile_fk"
                baseTableName="tblmmvno"
                baseColumnNames="profile_id"
                referencedTableName="tbltcustprofile"
                referencedColumnNames="profile_id"
                onDelete="RESTRICT"
                onUpdate="RESTRICT"/>

    </changeSet>

</databaseChangeLog>