<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="ZSS0027042601" author="INTL049" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tblm_pulse_management"/>
            </not>
        </preConditions>
        <createTable tableName="tblm_pulse_management">
            <column name="pulse_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pulse_name" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="pulse_unit" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="pulse_value" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="rounding_mode" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="rate_per_pulse" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(50)"/>
            <column name="created_date" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="modified_by" type="VARCHAR(50)"/>
            <column name="modified_date" type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="ZSS0027042602" author="INTL049" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tblm_rate_package"/>
            </not>
        </preConditions>
        <createTable tableName="tblm_rate_package">
            <column name="rate_package_id" type="BIGINT">
                <constraints primaryKey="true"/>
            </column>
            <column name="pulse_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="package_name" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="service_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <!--            <column name="start_date" type="TIMESTAMP">-->
            <!--                <constraints nullable="false"/>-->
            <!--            </column>-->
            <column name="is_deleted" type="tinyint(1)" defaultValue="0"/>
            <!--            <column name="expiry_date" type="TIMESTAMP"/>-->
            <column name="created_by" type="VARCHAR(50)"/>
            <column name="created_date" type="TIMESTAMP"/>
            <column name="modified_by" type="VARCHAR(50)"/>
            <column name="modified_date" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="tblm_rate_package"
                baseColumnNames="pulse_id"
                referencedTableName="tblm_pulse_management"
                referencedColumnNames="pulse_id"
                constraintName="fk_rate_package_pulse"
                onDelete="RESTRICT"/>
    </changeSet>

    <changeSet id="ZSS0027042603" author="INTL049" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tblm_rate_package_group"/>
            </not>
        </preConditions>
        <createTable tableName="tblm_rate_package_group">
            <column name="group_id" type="BIGINT">
                <constraints primaryKey="true"/>
            </column>
            <column name="group_name" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="TEXT"/>
            <!--            <column name="effective_date" type="TIMESTAMP">-->
            <!--                <constraints nullable="false"/>-->
            <!--            </column>-->
            <column name="is_deleted" type="tinyint(1)" defaultValue="0"/>
            <!--            <column name="expiry_date" type="TIMESTAMP"/>-->
            <column name="created_date" type="TIMESTAMP"/>
            <column name="modified_date" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- 4. Create Mapping Table -->
    <changeSet id="ZSS0027042604" author="INTL049" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tblt_rate_package_group_mapping"/>
            </not>
        </preConditions>
        <createTable tableName="tblt_rate_package_group_mapping">
            <column name="mapping_id" type="BIGINT">
                <constraints primaryKey="true"/>
            </column>
            <column name="group_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="rate_package_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="nas_ip" type="VARCHAR(45)">
                <constraints nullable="false"/>
            </column>
            <column name="effective_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="expiry_date" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="tblt_rate_package_group_mapping"
                baseColumnNames="group_id"
                constraintName="fk_mapping_group"
                referencedTableName="tblm_rate_package_group"
                referencedColumnNames="group_id"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableName="tblt_rate_package_group_mapping"
                baseColumnNames="rate_package_id"
                constraintName="fk_mapping_package"
                referencedTableName="tblm_rate_package"
                referencedColumnNames="rate_package_id"
                onDelete="CASCADE"/>
    </changeSet>

