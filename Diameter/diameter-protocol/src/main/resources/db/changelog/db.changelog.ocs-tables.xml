    <!-- Changeset for RatePackageGroupMapping: Add package_type and pulse configuration fields -->
    <changeSet id="ZSS00270426038" author="INTL049" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="tblt_rate_package_group_mapping"/>
            <not>
                <columnExists tableName="tblt_rate_package_group_mapping" columnName="package_type"/>
            </not>
        </preConditions>
        <comment>
            Add package_type column to distinguish between NON_MONETARY and MONETARY mappings.
            Add pulse configuration fields (pulse_value, pulse_unit, rounding_mode) for NON_MONETARY mappings.
            Make rate_package_id nullable since NON_MONETARY mappings don't need a rate package.
        </comment>

        <!-- Add package_type column -->
        <addColumn tableName="tblt_rate_package_group_mapping">
            <column name="package_type" type="VARCHAR(20)" defaultValue="MONETARY">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <!-- Add pulse configuration fields for NON_MONETARY -->
        <addColumn tableName="tblt_rate_package_group_mapping">
            <column name="pulse_value" type="INT">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <addColumn tableName="tblt_rate_package_group_mapping">
            <column name="pulse_unit" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <addColumn tableName="tblt_rate_package_group_mapping">
            <column name="rounding_mode" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <!-- Make rate_package_id nullable for NON_MONETARY mappings -->
        <dropNotNullConstraint tableName="tblt_rate_package_group_mapping"
                               columnName="rate_package_id"
                               columnDataType="BIGINT"/>

        <!-- Add unique constraint: one mapping per zone per packageType -->
        <addUniqueConstraint tableName="tblt_rate_package_group_mapping"
                             columnNames="group_id, zone_mapping_id, package_type"
                             constraintName="uk_zone_package_type"/>

        <!-- Add index for fast lookups -->
