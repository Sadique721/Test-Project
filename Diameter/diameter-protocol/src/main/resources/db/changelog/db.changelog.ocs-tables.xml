    <changeSet id="ZSS0027042609" author="INTL049" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tblt_rated_record"/>
            </not>
        </preConditions>

        <createTable tableName="tblt_rated_record">
            <column name="rated_record_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="aaa_record_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="session_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="customer_id" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="username" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="nas_ip" type="VARCHAR(45)">
                <constraints nullable="false"/>
            </column>

            <column name="total_data_usage_bytes" type="DECIMAL(20,2)">
                <constraints nullable="false"/>
            </column>

            <column name="total_data_usage_mb" type="DECIMAL(20,2)">
                <constraints nullable="false"/>
            </column>

            <column name="total_data_usage_gb" type="DECIMAL(20,2)">
                <constraints nullable="false"/>
            </column>

            <column name="session_start_time" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="session_end_time" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="session_duration_seconds" type="BIGINT"/>

            <column name="service_type" type="VARCHAR(50)"/>

            <column name="postpaid_plan_id" type="INT"/>
            <column name="postpaid_plan_name" type="VARCHAR(100)"/>
            <column name="plan_group" type="VARCHAR(100)"/>
            <column name="plan_type" type="VARCHAR(50)"/>

            <column name="rate_package_id" type="BIGINT"/>
            <column name="rate_package_name" type="VARCHAR(100)"/>
            <column name="rate_package_group_id" type="BIGINT"/>
            <column name="rate_package_group_name" type="VARCHAR(100)"/>
            <column name="rate_per_unit" type="DECIMAL(10,4)"/>
            <column name="rate_unit" type="VARCHAR(10)"/>
            <column name="rounding_mode" type="VARCHAR(20)"/>

            <!-- Charging Information -->
            <column name="base_charge" type="DECIMAL(20,2)"/>
            <column name="overage_charge" type="DECIMAL(20,2)"/>
            <column name="total_charge" type="DECIMAL(20,2)">
                <constraints nullable="false"/>
            </column>
            <column name="tax_amount" type="DECIMAL(20,2)"/>
            <column name="final_amount" type="DECIMAL(20,2)">
                <constraints nullable="false"/>
            </column>

            <!-- Usage Information -->
            <column name="included_quota_mb" type="DECIMAL(20,2)"/>
            <column name="included_quota_gb" type="DECIMAL(20,2)"/>
            <column name="overage_usage_mb" type="DECIMAL(20,2)"/>
            <column name="overage_usage_gb" type="DECIMAL(20,2)"/>
            <column name="usage_percentage" type="DECIMAL(20,2)"/>

            <!-- Rating Status -->
            <column name="rating_status" type="VARCHAR(20)" defaultValue="RATED">
                <constraints nullable="false"/>
            </column>
            <column name="rating_error_message" type="TEXT"/>
            <column name="rating_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="rated_by" type="VARCHAR(50)" defaultValue="RATING_ENGINE"/>
            <column name="created_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="modified_date" type="TIMESTAMP"/>
        </createTable>
    </changeSet>


    <changeSet id="ZSS00270426010" author="INTL049" runOnChange="true">

        <!-- Preconditions: Only run if columns exist in source and don't exist in target -->
        <preConditions onFail="MARK_RAN">
            <and>
                <columnExists tableName="tblm_pulse_management" columnName="rate_per_pulse"/>
                <columnExists tableName="tblm_pulse_management" columnName="rounding_mode"/>
                <not>
                    <columnExists tableName="tblm_rate_package" columnName="rate_per_pulse"/>
                </not>
                <not>
                    <columnExists tableName="tblm_rate_package" columnName="rounding_mode"/>
                </not>
            </and>
        </preConditions>

        <!-- Remove columns from tblm_pulse_management -->
        <dropColumn tableName="tblm_pulse_management" columnName="rate_per_pulse"/>
        <dropColumn tableName="tblm_pulse_management" columnName="rounding_mode"/>

        <!-- Add columns to tblm_rate_package -->
        <addColumn tableName="tblm_rate_package">
            <column name="rate_per_pulse" type="DECIMAL(10,2)" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="rounding_mode" type="VARCHAR(20)" defaultValue="">
                <constraints nullable="false"/>
            </column>
        </addColumn>

    </changeSet>

    <changeSet id="ZSS00270426011" author="INTL049" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <!-- Only run if 'nas_ip' column exists -->
            <columnExists tableName="tblt_rate_package_group_mapping" columnName="nas_ip"/>
            <!-- Only run if 'nas_ip_pattern' column does NOT already exist -->
            <not>
                <columnExists tableName="tblt_rate_package_group_mapping" columnName="nas_ip_pattern"/>
            </not>
        </preConditions>

        <!-- Rename the column -->
        <renameColumn
                tableName="tblt_rate_package_group_mapping"
                oldColumnName="nas_ip"
                newColumnName="nas_ip_pattern"
                columnDataType="VARCHAR(100)"/>

        <!-- Optional: Wrap existing IPs as exact regex pattern -->
        <update tableName="tblt_rate_package_group_mapping">
            <column name="nas_ip_pattern" valueComputed="'^' || nas_ip_pattern || '$'"/>
        </update>
    </changeSet>

    <changeSet id="ZSS00270426012" author="INTL049" runOnChange="true">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="tblt_rate_package_group_mapping" columnName="nas_ip_pattern"/>
            <not>
                <columnExists tableName="tblt_rate_package_group_mapping" columnName="checked_item"/>
            </not>
        </preConditions>

        <!-- Rename the column and increase length -->
        <renameColumn
                tableName="tblt_rate_package_group_mapping"
                oldColumnName="nas_ip_pattern"
                newColumnName="checked_item"
                columnDataType="VARCHAR(255)"/>
    </changeSet>

