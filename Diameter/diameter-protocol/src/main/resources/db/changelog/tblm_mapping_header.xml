<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- Create mapping_header table -->
    <changeSet id="create-tblm_packet_mapping_header_table" author="auto-generated">
		<preConditions onFail="MARK_RAN" onError="MARK_RAN">
			<not>
				<tableExists tableName="tblm_packet_mapping_header"/>
			</not>
		</preConditions>
        <createTable tableName="tblm_packet_mapping_header">
            <column name="id" type="VARCHAR(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="request_type" type="VARCHAR(255)"/>
            <column name="response_type" type="VARCHAR(255)"/>
            <column name="enabled" type="boolean" defaultValueBoolean="true">
	            <constraints nullable="false"/>
	        </column>
            <column name="description" type="VARCHAR(500)"/>
            <column name="created_date" type="TIMESTAMP"/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="modified_date" type="TIMESTAMP"/>
            <column name="modified_by" type="VARCHAR(100)"/>
        </createTable>
    </changeSet>
	<changeSet id="addColumns" author="auto-generated">
	    <addColumn tableName="tblm_packet_mapping_header">
	        <column name="application" type="VARCHAR(10)">
	            <constraints nullable="false"/>
	        </column>
	        <column name="vendor_id" type="INT">
	            <constraints nullable="false"/>
	        </column>
	    </addColumn>
	</changeSet>
	<changeSet id="add-include-standard-avp-boolean" author="auto-generated">
		<addColumn tableName="tblm_packet_mapping_header">
	        <column name="include_standard_avp" type="BOOLEAN"/>
	    </addColumn>
		<update tableName="tblm_packet_mapping_header">
	        <column name="include_standard_avp" valueBoolean="false"/>
	    </update>
		 <addDefaultValue tableName="tblm_packet_mapping_header"
	                     columnName="include_standard_avp"
	                     defaultValueBoolean="false"/>
	</changeSet>
	<changeSet id="add-cc-request-type-and-peer-to-packet-mapping-header" author="auto-generated">
		<addColumn tableName="tblm_packet_mapping_header">
			<column name="cc_request_type" type="VARCHAR(20)">
				<constraints nullable="true"/>
			</column>
			<column name="peer" type="VARCHAR(4000)">
				<constraints nullable="true"/>
			</column>
		</addColumn>
	</changeSet>

</databaseChangeLog>