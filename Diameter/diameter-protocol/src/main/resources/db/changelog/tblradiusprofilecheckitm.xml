<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-tblradiusprofilecheckitm-001" author="initial-change">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tblradiusprofilecheckitm"/>
            </not>
        </preConditions>

        <!-- Create Table -->
        <createTable tableName="tblradiusprofilecheckitm">

            <column name="radiuscheckitmid" type="BIGINT">
                <constraints primaryKey="true"
                             primaryKeyName="radiusprofilecheckitm_radiuscheckitmid_unq"
                             nullable="false"/>
            </column>

            <column name="checkitem" type="VARCHAR(150)"/>

            <column name="radiusprofileid" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="createbyname" type="VARCHAR(100)"/>
            <column name="updatebyname" type="VARCHAR(100)"/>

            <column name="CREATEDBYSTAFFID" type="DECIMAL(20,0)" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>

            <column name="LASTMODIFIEDBYSTAFFID" type="DECIMAL(20,0)" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>

            <column name="createdate" type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="lastmodifieddate" type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP"/>

            <column name="is_deleted" type="TINYINT(1)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

        </createTable>

    </changeSet>

</databaseChangeLog>