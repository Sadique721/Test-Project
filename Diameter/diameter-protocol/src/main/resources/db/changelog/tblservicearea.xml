<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-tblservicearea-001" author="initial-change">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tblservicearea"/>
            </not>
        </preConditions>

        <createTable tableName="tblservicearea">

            <column name="service_area_id" type="BIGINT">
                <constraints primaryKey="true"
                             nullable="false"
                             primaryKeyName="pk_tblservicearea"/>
            </column>

            <column name="name" type="VARCHAR(100)"/>

            <column name="status" type="VARCHAR(50)"/>

            <column name="is_deleted" type="TINYINT(1)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="CREATEDATE" type="TIMESTAMP"/>

            <column name="LASTMODIFIEDDATE" type="TIMESTAMP"/>

            <column name="CREATEDBYSTAFFID" type="DECIMAL(20,0)"/>

            <column name="LASTMODIFIEDBYSTAFFID" type="DECIMAL(20,0)"/>

            <column name="createbyname" type="VARCHAR(100)"/>

            <column name="updatebyname" type="VARCHAR(100)"/>

            <column name="MVNOID" type="BIGINT"/>

            <column name="latitude" type="VARCHAR(50)"/>

            <column name="longitude" type="VARCHAR(50)"/>

            <column name="areaid" type="BIGINT"/>

            <column name="cityid" type="BIGINT"/>

            <column name="site_name" type="VARCHAR(250)"/>

        </createTable>


        <!-- Index on areaid -->
        <createIndex indexName="tblservicearea_FK_4"
                     tableName="tblservicearea">
            <column name="areaid"/>
        </createIndex>

        <!-- Index on MVNOID -->
        <createIndex indexName="tblserviceareas_ibfk_1"
                     tableName="tblservicearea">
            <column name="MVNOID"/>
        </createIndex>

        <!-- Composite index (cityid, is_deleted) -->
        <createIndex indexName="idx_servicearea_cityid_deleted"
                     tableName="tblservicearea">
            <column name="cityid"/>
            <column name="is_deleted"/>
        </createIndex>


        <!-- FK to tblmarea -->
        <addForeignKeyConstraint
                constraintName="tblservicearea_FK_4"
                baseTableName="tblservicearea"
                baseColumnNames="areaid"
                referencedTableName="tblmarea"
                referencedColumnNames="areaid"
                onDelete="RESTRICT"
                onUpdate="RESTRICT"/>

        <!-- FK to tblmmvno -->
        <addForeignKeyConstraint
                constraintName="tblserviceareas_ibfk_1"
                baseTableName="tblservicearea"
                baseColumnNames="MVNOID"
                referencedTableName="tblmmvno"
                referencedColumnNames="MVNOID"
                onDelete="RESTRICT"
                onUpdate="RESTRICT"/>

    </changeSet>

</databaseChangeLog>