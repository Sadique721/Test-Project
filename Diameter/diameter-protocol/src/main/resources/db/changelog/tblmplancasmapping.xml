<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-tblmplancasmapping-001" author="initial-change">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tblmplancasmapping"/>
            </not>
        </preConditions>

        <!-- Create Table -->
        <createTable tableName="tblmplancasmapping">

            <column name="plancasmappingid" type="BIGINT" >
                <constraints primaryKey="true"
                             primaryKeyName="pk_tblmplancasmapping"
                             nullable="false"/>
            </column>

            <column name="planid" type="BIGINT"/>
            <column name="casid" type="BIGINT"/>
            <column name="packageid" type="BIGINT"/>

        </createTable>


        <!-- Index for planid -->
        <createIndex tableName="tblmplancasmapping"
                     indexName="planid_fk">
            <column name="planid"/>
        </createIndex>

        <!-- Index for casid -->
        <createIndex tableName="tblmplancasmapping"
                     indexName="casid_fk">
            <column name="casid"/>
        </createIndex>


        <!-- Foreign Key: planid -> tblmpostpaidplan -->
        <addForeignKeyConstraint
                baseTableName="tblmplancasmapping"
                baseColumnNames="planid"
                constraintName="planid_fk"
                referencedTableName="tblmpostpaidplan"
                referencedColumnNames="POSTPAIDPLANID"/>


        <!-- Foreign Key: casid -> tbltcasmaster -->
        <addForeignKeyConstraint
                baseTableName="tblmplancasmapping"
                baseColumnNames="casid"
                constraintName="casid_fk"
                referencedTableName="tbltcasmaster"
                referencedColumnNames="id"/>

    </changeSet>

</databaseChangeLog>