<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-tblradiusprofilereplyitm-001" author="initial-change">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="tblradiusprofilecheckitm"/>
            </not>
        </preConditions>

        <!-- Create Table -->
        <createTable tableName="tblradiusprofilereplyitm">

            <column name="radiusreplyitmid" type="BIGINT">
                <constraints primaryKey="true"
                             primaryKeyName="radiusprofilereplyitm_radiusreplyitmid_unq"
                             nullable="false"/>
            </column>

            <column name="attribute" type="VARCHAR(150)"/>
            <column name="attributevalue" type="VARCHAR(150)"/>

            <column name="radiusprofileid" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="radiuscheckitmid" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="createbyname" type="VARCHAR(100)"/>
            <column name="updatebyname" type="VARCHAR(100)"/>

            <column name="CREATEDBYSTAFFID" type="DECIMAL(20,0)" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>

            <column name="LASTMODIFIEDBYSTAFFID" type="DECIMAL(20,0)" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>

            <column name="createdate" type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="lastmodifieddate" type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP"/>

            <column name="MVNOID" type="BIGINT"/>

        </createTable>


        <!-- Index for MVNOID -->
        <createIndex
                tableName="tblradiusprofilereplyitm"
                indexName="tblradiusprofilereplyitm_ibfk_1">
            <column name="MVNOID"/>
        </createIndex>


        <!-- Foreign Key: MVNOID -->
        <addForeignKeyConstraint
                baseTableName="tblradiusprofilereplyitm"
                baseColumnNames="MVNOID"
                constraintName="tblradiusprofilereplyitm_ibfk_1"
                referencedTableName="tblmmvno"
                referencedColumnNames="MVNOID"/>

    </changeSet>

</databaseChangeLog>