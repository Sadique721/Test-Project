    <changeSet id="tblmplangroupmapping-0003" author="schema">

        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <tableExists tableName="tblmplangroupmapping"/>
            </not>
        </preConditions>

        <createTable tableName="tblmplangroupmapping">

            <!-- Primary Key -->
            <column name="plangroupmappingid" type="int">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <!-- Foreign Key: Postpaid Plan -->
            <column name="POSTPAIDPLANID" type="bigint"/>

            <!-- Service -->
            <column name="service" type="varchar(40)">
                <constraints nullable="false"/>
            </column>

            <!-- Foreign Key: Plan Group -->
            <column name="plangroupid" type="bigint"/>

            <!-- Soft Delete -->
            <column name="is_deleted" type="tinyint(1)"
                    defaultValueNumeric="0"/>

            <!-- MVNO -->
            <column name="MVNOID" type="int"/>

            <!-- Offer Price -->
            <column name="newofferprice" type="double"/>

            <!-- Auditable Fields -->
            <column name="CREATEDATE" type="datetime">
                <constraints nullable="false"/>
            </column>

            <column name="LASTMODIFIEDDATE" type="datetime"/>

            <column name="createbyname" type="varchar(40)">
                <constraints nullable="false"/>
            </column>

            <column name="updatebyname" type="varchar(40)">
                <constraints nullable="false"/>
            </column>

            <column name="CREATEDBYSTAFFID" type="int">
                <constraints nullable="false"/>
            </column>

            <column name="LASTMODIFIEDBYSTAFFID" type="int">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <!-- Indexes -->
        <createIndex indexName="idx_plangroupmapping_plan"
                     tableName="tblmplangroupmapping">
            <column name="POSTPAIDPLANID"/>
        </createIndex>

        <createIndex indexName="idx_plangroupmapping_group"
                     tableName="tblmplangroupmapping">
            <column name="plangroupid"/>
        </createIndex>

        <!-- Foreign Keys -->
        <addForeignKeyConstraint
                constraintName="fk_plangroupmapping_plan"
                baseTableName="tblmplangroupmapping"
                baseColumnNames="POSTPAIDPLANID"
                referencedTableName="tblmpostpaidplan"
                referencedColumnNames="POSTPAIDPLANID"
                onDelete="RESTRICT"
                onUpdate="CASCADE"/>

        <addForeignKeyConstraint
                constraintName="fk_plangroupmapping_group"
                baseTableName="tblmplangroupmapping"
                baseColumnNames="plangroupid"
                referencedTableName="tblmplangroup"
                referencedColumnNames="plangroupid"
                onDelete="RESTRICT"
                onUpdate="CASCADE"/>

    </changeSet>

